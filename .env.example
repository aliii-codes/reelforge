# Copy to .env and fill in only what you use. Never commit .env.
# All keys are optional: the --script-file workflow needs none of them.

# --- LLM providers (tried in this order with REELFORGE_LLM_PROVIDER=auto) ---
# Groq free plan (no card at time of checking): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Cohere trial key (free, rate-limited, 1,000 calls/month at time of checking): https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
# Optional local model through a running Ollama server (not installed by ReelForge)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
REELFORGE_LLM_PROVIDER=auto

# --- Research ---
# Optional Tavily search (free plan 1,000 credits/month at time of checking); Wikipedia is used otherwise
TAVILY_API_KEY=
# Contact info for the Wikipedia User-Agent (Wikimedia API etiquette), e.g. an email or URL
REELFORGE_CONTACT=

# --- Voice / transcription ---
REELFORGE_WHISPER_MODEL=base.en
REELFORGE_WHISPER_THREADS=4
REELFORGE_STOCK_VOICE=marius
REELFORGE_VOICE_PROFILE=default
REELFORGE_TAKES=3

# --- Rendering / output ---
REELFORGE_RENDER_CONCURRENCY=4
REELFORGE_HANDLE=
# REELFORGE_OUTPUT_DIR=output
# REELFORGE_DATA_DIR=data
# REELFORGE_VOICE_DIR=voice_data
